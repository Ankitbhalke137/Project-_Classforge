generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String                   @db.VarChar(150)
  slug                    String                   @unique @db.VarChar(100)
  status                  TenantStatus             @default(ACTIVE)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  academicTerms           AcademicTerm[]
  academicYears           AcademicYear[]
  announcements           Announcement[]
  attendanceRecords       AttendanceRecord[]
  classes                 SchoolClass[]
  enrolments              Enrolment[]
  exams                   Exam[]
  marks                   Mark[]
  memberships             Membership[]
  notificationPreferences NotificationPreference[]
  students                Student[]
  teachers                Teacher[]
  teachingAssignments     TeachingAssignment[]
  timetablePeriods        TimetablePeriod[]
  timetableSlots          TimetableSlot[]

  @@map("tenants")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String                   @db.VarChar(150)
  email                   String                   @unique @db.VarChar(255)
  passwordHash            String                   @map("password_hash") @db.VarChar(255)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  platformRole            PlatformRole?            @map("platform_role")
  announcements           Announcement[]
  attendanceMarked        AttendanceRecord[]
  gradedMarks             Mark[]
  memberships             Membership[]
  notificationPreferences NotificationPreference[]
  refreshTokens           RefreshToken[]
  students                Student[]
  teachers                Teacher[]

  @@map("users")
}

model Membership {
  tenantId String           @map("tenant_id") @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  role     MembershipRole
  status   MembershipStatus @default(ACTIVE)
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model AcademicYear {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  name       String             @db.VarChar(50)
  startDate  DateTime           @map("start_date") @db.Date
  endDate    DateTime           @map("end_date") @db.Date
  status     AcademicYearStatus @default(UPCOMING)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  terms      AcademicTerm[]
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes    SchoolClass[]
  enrolments Enrolment[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("academic_years")
}

/// *
///  * One term inside an academic year — "Term 1", "Term 2", and so on.
///  *
///  * Kept separate from `AcademicYear` so a school can name and date its own
///  * terms without the code assuming three equal splits.
model AcademicTerm {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  label          String       @db.VarChar(50)
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  position       Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  academicYear   AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, label])
  @@index([tenantId, academicYearId, position])
  @@map("academic_terms")
}

/// *
///  * One row of a school's daily timetable — period number and its clock times.
///  *
///  * `startTime` and `endTime` are stored as "HH:MM" strings rather than times,
///  * because a period is a wall-clock label a school sets, not an instant.
model TimetablePeriod {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  period    Int
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)
  label     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("timetable_periods")
}

/// *
///  * One subject, in one section, in one period of the week.
///  *
///  * The period row (`TimetablePeriod`) carries the clock times; this table only
///  * says what happens in that slot for that class.
model TimetableSlot {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  day       String   @db.VarChar(12)
  period    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sectionId, day, period])
  @@index([tenantId, sectionId])
  @@index([tenantId, teacherId])
  @@map("timetable_slots")
}

/// *
///  * One person's notification choices inside one school.
///  *
///  * Per school, not per account: the same person can be a teacher in one school
///  * and a parent in another, and each reaches them its own way.
model NotificationPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  inAppNotifications Boolean  @default(true) @map("in_app_notifications")
  emailNotifications Boolean  @default(false) @map("email_notifications")
  classAnnouncements Boolean  @default(true) @map("class_announcements")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("notification_preferences")
}

model SchoolClass {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  academicYearId    String       @map("academic_year_id") @db.Uuid
  name              String       @db.VarChar(50)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  room              String?      @db.VarChar(50)
  capacity          Int          @default(0)
  /// * Plain uuid rather than a relation: a teacher leaving must not delete the class.
  homeroomTeacherId String?      @map("homeroom_teacher_id") @db.Uuid
  academicYear      AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Cascade)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections          Section[]
  subjects          Subject[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, name])
  @@index([tenantId, academicYearId])
  @@map("classes")
}

model Section {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  classId             String               @map("class_id") @db.Uuid
  name                String               @db.VarChar(50)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  announcements       Announcement[]
  attendanceRecords   AttendanceRecord[]
  enrolments          Enrolment[]
  exams               Exam[]
  schoolClass         SchoolClass          @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]
  timetableSlots      TimetableSlot[]

  @@unique([tenantId, id])
  @@unique([tenantId, classId, name])
  @@index([tenantId, classId])
  @@map("sections")
}

model Subject {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  classId             String               @map("class_id") @db.Uuid
  name                String               @db.VarChar(100)
  code                String?              @db.VarChar(30)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  exams               Exam[]
  schoolClass         SchoolClass          @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]
  timetableSlots      TimetableSlot[]

  @@unique([tenantId, id])
  @@unique([tenantId, classId, name])
  @@index([tenantId, classId])
  @@map("subjects")
}

model Student {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  userId            String?            @map("user_id") @db.Uuid
  admissionNo       String             @map("admission_no") @db.VarChar(50)
  firstName         String             @map("first_name") @db.VarChar(100)
  lastName          String             @map("last_name") @db.VarChar(100)
  dateOfBirth       DateTime?          @map("date_of_birth") @db.Date
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  phone             String?            @db.VarChar(50)
  guardianName      String?            @map("guardian_name") @db.VarChar(150)
  guardianPhone     String?            @map("guardian_phone") @db.VarChar(50)
  /// * Mirrors the active enrolment so the roster can filter without a join.
  status            String             @default("ACTIVE") @db.VarChar(20)
  attendanceRecords AttendanceRecord[]
  enrolments        Enrolment[]
  marks             Mark[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, admissionNo])
  @@unique([tenantId, userId])
  @@index([tenantId, lastName])
  @@map("students")
}

model Teacher {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  userId              String?              @map("user_id") @db.Uuid
  employeeNo          String?              @map("employee_no") @db.VarChar(50)
  firstName           String               @map("first_name") @db.VarChar(100)
  lastName            String               @map("last_name") @db.VarChar(100)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  phone               String?              @db.VarChar(50)
  qualification       String?              @db.VarChar(150)
  designation         String?              @db.VarChar(100)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id])
  teachingAssignments TeachingAssignment[]
  timetableSlots      TimetableSlot[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@unique([tenantId, employeeNo])
  @@index([tenantId, lastName])
  @@map("teachers")
}

model Enrolment {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  sectionId      String          @map("section_id") @db.Uuid
  academicYearId String          @map("academic_year_id") @db.Uuid
  status         EnrolmentStatus @default(ACTIVE)
  enrolledAt     DateTime        @default(now()) @map("enrolled_at") @db.Timestamp(6)
  academicYear   AcademicYear    @relation(fields: [tenantId, academicYearId], references: [tenantId, id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section        Section         @relation(fields: [tenantId, sectionId], references: [tenantId, id])
  student        Student         @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, studentId])
  @@index([tenantId, sectionId, academicYearId])
  @@map("enrolments")
}

model TeachingAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section   Section  @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Cascade)
  subject   Subject  @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, teacherId, sectionId, subjectId])
  @@index([tenantId, sectionId])
  @@index([tenantId, teacherId])
  @@map("teaching_assignments")
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  markedBy       String           @map("marked_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  marker         User             @relation(fields: [markedBy], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section        Section          @relation(fields: [tenantId, sectionId], references: [tenantId, id])
  student        Student          @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, sectionId, studentId, attendanceDate])
  @@index([tenantId, studentId, attendanceDate])
  @@map("attendance_records")
}

model Exam {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  subjectId   String     @map("subject_id") @db.Uuid
  sectionId   String     @map("section_id") @db.Uuid
  name        String     @db.VarChar(100)
  examDate    DateTime   @map("exam_date") @db.Date
  maxMarks    Int        @map("max_marks")
  status      ExamStatus @default(SCHEDULED)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  term        String?    @db.VarChar(50)
  passMarks   Int        @default(0) @map("pass_marks")
  /// * Set when the marks are released to students and parents.
  publishedAt DateTime?  @map("published_at") @db.Timestamp(6)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section    @relation(fields: [tenantId, sectionId], references: [tenantId, id])
  subject     Subject    @relation(fields: [tenantId, subjectId], references: [tenantId, id])
  marks       Mark[]

  @@unique([tenantId, id])
  @@index([tenantId, sectionId, examDate])
  @@index([tenantId, subjectId])
  @@map("exams")
}

model Mark {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  score     Decimal  @db.Decimal(7, 2)
  gradedBy  String?  @map("graded_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  remarks   String?  @db.VarChar(300)
  grader    User?    @relation(fields: [gradedBy], references: [id])
  exam      Exam     @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, examId, studentId])
  @@index([tenantId, studentId])
  @@map("marks")
}

model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  sectionId   String?              @map("section_id") @db.Uuid
  createdBy   String               @map("created_by") @db.Uuid
  title       String               @db.VarChar(200)
  content     String
  publishedAt DateTime?            @map("published_at") @db.Timestamp(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)
  /// * Which groups see this on their announcement list.
  audience    String[]             @default(["EVERYONE"])
  priority    AnnouncementPriority @default(NORMAL)
  /// * Pinned notices sort above everything else.
  pinned      Boolean              @default(false)
  creator     User                 @relation(fields: [createdBy], references: [id])
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section?             @relation(fields: [tenantId, sectionId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, publishedAt])
  @@index([tenantId, sectionId])
  @@index([tenantId, pinned, publishedAt])
  @@map("announcements")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model login_rate_limits {
  key        String   @id @db.VarChar(255)
  points     Int
  expire_at  DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  IN_PROGRESS
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum PlatformRole {
  SUPER_ADMIN
}
