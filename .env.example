# Copy to .env.local and fill in. Never commit a real .env.local — .gitignore blocks it.

# Neon Postgres connection string. Use the scoped APP user for the app itself and
# keep the owner account for migrations only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Dedicated application role connection URL without BYPASSRLS / SUPERUSER (used in CI & production)
APP_DATABASE_URL="postgresql://classforge_app:PASSWORD@HOST/neondb?sslmode=require"
# Privileged role used for executing schema migrations and test setup
SETUP_DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require"

# Signs the access token. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=""

# Secret used to HMAC-sign session-bound CSRF tokens.
# Must be at least 32 characters (falls back to JWT_SECRET if unset).
CSRF_SECRET=""

# --- Login Rate Limiting Configuration ---
# Maximum login attempts allowed per account/pair in the time window (default: 5)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
# Maximum login attempts allowed per client IP across all accounts (default: 20)
RATE_LIMIT_IP_MAX_ATTEMPTS=20
# Sliding window size in seconds (default: 900 = 15 minutes)
RATE_LIMIT_LOGIN_WINDOW_SEC=900
# Rate limit storage driver: "auto" (default: PostgreSQL table) | "postgres" | "memory"
RATE_LIMIT_STORE=auto
# Failure policy when shared store is unreachable: "fallback" (default: memory fallback) | "fail_closed"
RATE_LIMIT_ON_STORE_ERROR=fallback
# Set to "true" only when deployed behind trusted reverse proxy (Vercel, Cloudflare, AWS ALB)
TRUST_PROXY=false

# The API routes live inside this Next app, so the client calls its own origin.
# Leave empty. A value here points the frontend at a different server, and every
# request fails with ERR_CONNECTION_REFUSED.
NEXT_PUBLIC_API_BASE_URL=""

# --- SMTP (Gmail: superadminclassforge@gmail.com) ---
# SMTP_PASS is the 16-character Gmail App Password for this account
# (Google Account -> Security -> App passwords). Not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=superadminclassforge@gmail.com
SMTP_PASS=""
SMTP_FROM=superadminclassforge@gmail.com
SMTP_FROM_NAME=ClassForge Super Admin

# Absolute base URL of this app. Used to build the sign-in link in invite emails.
NEXTAUTH_URL=http://localhost:3000
