# Copy to .env.local and fill in. Never commit a real .env.local — .gitignore blocks it.

# Neon Postgres connection string. Use the scoped APP user for the app itself and
# keep the owner account for migrations only.
#
# The three extra parameters matter on a pooled endpoint:
#   pgbouncer=true    tells Prisma the server is a transaction pooler. Without
#                     it, a connection the pooler has closed comes back as
#                     "Server has closed the connection".
#   connection_limit  how many connections this app holds open. The pooler
#                     multiplexes them, so a small number is right — the
#                     default (17) is more than the pooler wants from one
#                     client and ends in "Timed out fetching a new connection".
#   pool_timeout      how long to wait for one, in seconds.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=5&pool_timeout=30"

# Signs the access token. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=""

# The API routes live inside this Next app, so the client calls its own origin.
# Leave empty. A value here points the frontend at a different server, and every
# request fails with ERR_CONNECTION_REFUSED.
NEXT_PUBLIC_API_BASE_URL=""

# Absolute base URL of this app, used to build the sign-in link in an invite
# email. Leave empty when the app and the API share one origin.
APP_URL=""

# --- SMTP ---
# Used to email a new account its first password. Without these the app still
# works: the password is shown to the admin once and shared by hand instead.
# For Gmail, use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME=ClassForge Super Admin
